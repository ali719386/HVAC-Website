# Brand selection (folder name in /brands). Put this in .env.local on Windows.
NEXT_PUBLIC_BRAND=default
# Public canonical URL, overrides brand seo.siteUrl when set (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# Resend email delivery (server only)
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_TO_EMAIL=

# Signed webhook delivery (server only). Signature: HMAC-SHA256 hex of the raw body in X-Lead-Signature
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Optional distributed rate limiting (Upstash Redis REST). Disabled when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Cloudflare Turnstile. Disabled unless BOTH are set.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Development only: show a banner on pages whose content is still placeholder (they stay noindex either way).
SHOW_PLACEHOLDER_NOTICE=false

# Optional AI answers for the website assistant (Google Gemini, server only). Scripted answers when unset.
# Set it before `npm run build`: pages read it at build time. Questions typed in the chat are sent to Google.
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest)
GEMINI_MODEL=
